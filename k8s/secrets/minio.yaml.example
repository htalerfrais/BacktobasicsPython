# Dev / Minikube only. Copy to minio.yaml (gitignored) before deploying:
#   Copy-Item k8s\secrets\minio.yaml.example k8s\secrets\minio.yaml
# In production use Sealed Secrets, Vault, or kubectl create secret.
apiVersion: v1
kind: Secret
metadata:
  name: backtobasics-minio
  namespace: backtobasics
  labels:
    app.kubernetes.io/name: backtobasics
type: Opaque
stringData:
  MINIO_ROOT_USER: "minioadmin"
  MINIO_ROOT_PASSWORD: "minioadmin"
